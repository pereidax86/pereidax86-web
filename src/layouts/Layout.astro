---
import "../styles/global.css";
import FloatingBanner from "../components/FloatingBanner.astro";
import SocialShareSidebar from "../components/SocialShareSidebar.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

interface Props {
	title: string;
	description?: string;
	robots?: string;
	image?: string;
	type?: string;
	pubDate?: Date;
}

const {
	title,
	description = "Ingeniero en Sistemas y Maestro en TIC. Desmitificando la tecnología con Open Source, Linux y Ciberseguridad. Tutoriales y guías para profesionales y entusiastas.",
	robots = "index, follow",
	image = "/og-image.png",
	type = "profile",
	pubDate,
} = Astro.props;

const GA_MEASUREMENT_ID = "G-VV212086YH";

const cleanPathname =
	Astro.url.pathname.endsWith("/") && Astro.url.pathname !== "/"
		? Astro.url.pathname.slice(0, -1)
		: Astro.url.pathname;

const canonicalURL = new URL(
	cleanPathname,
	Astro.site || "https://pereidax86.com",
);

const fullImageURL = new URL(image, Astro.site || Astro.url).href;

const personSchema = {
	"@type": "Person",
	"@id": "https://pereidax86.com/#person",
	name: "Luis Pereida",
	url: "https://pereidax86.com",
	image: "https://pereidax86.com/og-image.png",
	jobTitle: "SysAdmin & Cybersecurity Specialist",
	worksFor: {
		"@type": "Organization",
		name: "SysAdminCtl Services",
	},
	sameAs: [
		"https://www.linkedin.com/in/pereidax86",
		"https://twitter.com/pereidax86",
		"https://github.com/pereidax86",
		"https://tiktok.com/@pereidax86",
		"https://instagram.com/pereidax86",
		"https://sessionize.com/pereidax86/",
		"https://www.twitch.tv/pereidax86",
		"https://www.facebook.com/people/pereidax86/61559816602008",
	],
	description: description,
};

const schemaGraph =
	type === "article"
		? [
				personSchema,
				{
					"@type": "BlogPosting",
					"@id": `${canonicalURL.href}#article`,
					isPartOf: {
						"@type": "WebPage",
						"@id": canonicalURL.href,
					},
					headline: title,
					description: description,
					image: fullImageURL,
					datePublished: pubDate ? pubDate.toISOString() : undefined,
					author: {
						"@type": "Person",
						name: "Luis Pereida",
						url: "https://pereidax86.com",
						sameAs: personSchema.sameAs,
					},
					publisher: {
						"@type": "Person",
						name: "Luis Pereida",
						url: "https://pereidax86.com",
						image: "https://pereidax86.com/og-image.png",
					},
					mainEntityOfPage: {
						"@type": "WebPage",
						"@id": canonicalURL.href,
					},
				},
		  ]
		: [personSchema];

// --- SCHEMA JSON-LD (Datos Estructurados para Google) ---
const schemaData = {
	"@context": "https://schema.org",
	"@graph": schemaGraph,
};
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="robots" content={robots} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Luis Pereida" />
		<meta
			name="keywords"
			content="Luis Pereida, SysAdmin, Linux, Ciberseguridad, CEH, Red Hat, IBM Cloud, TIC, Open Source, Python, Automation, DevOps, Tutoriales Tecnológicos"
		/>

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content={fullImageURL}
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		{type === "article" && pubDate && (
			<meta property="article:published_time" content={pubDate.toISOString()} />
		)}
		{type === "article" && (
			<meta property="article:author" content="https://pereidax86.com" />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@pereidax86" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content={fullImageURL}
		/>

		<script
			type="application/ld+json"
			set:html={JSON.stringify(schemaData)}
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Rubik:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>

		<script
			async
			src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
		></script>
		<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", GA_MEASUREMENT_ID);
		</script>

		{/* GOOGLE ADSENSE */}
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2399791481519972"
			crossorigin="anonymous"
			defer></script>

		{/* METRICOOL TRACKER */}
		<script is:inline>
			function loadScript(a) {
				var b = document.getElementsByTagName("head")[0],
					c = document.createElement("script");
				((c.type = "text/javascript"),
					(c.src = "https://tracker.metricool.com/resources/be.js"),
					(c.onreadystatechange = a),
					(c.onload = a),
					b.appendChild(c));
			}
			loadScript(function () {
				beTracker.t({ hash: "fbb093ef437984ba1efc0c70a8bd9815" });
			});
		</script>
	</head>

	<body
		class="bg-neutral-950 text-gray-200 font-sans antialiased min-h-screen flex flex-col items-center selection:bg-blue-500 selection:text-white"
	>
		<div
			class="fixed inset-0 z-[-1] bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
		>
		</div>

		{type === "article" && (
			<SocialShareSidebar title={title} url={canonicalURL.href} />
		)}

		<slot />

		<Footer />

		<FloatingBanner />

		<ScrollToTop />
	</body>
</html>

<style is:global>
	:root {
		--font-rubik: "Rubik", system-ui, sans-serif;
		--font-jetbrains: "JetBrains Mono", monospace;
	}
	body {
		font-family: var(--font-rubik);
	}
	.font-mono {
		font-family: var(--font-jetbrains) !important;
	}

	@keyframes fadeIn {
		0% {
			opacity: 0;
			transform: translateY(10px);
		}
		99% {
			opacity: 1;
			transform: translateY(0);
		}
		100% {
			opacity: 1;
			transform: none;
		}
	}
	.animate-fade-in {
		animation: fadeIn 0.8s ease-out forwards;
	}
</style>

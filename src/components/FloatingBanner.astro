---
// src/components/FloatingBanner.astro

const socialNetworks = [
    {
        name: "TikTok",
        url: "https://tiktok.com/@pereidax86",
        color: "border-pink-500",
        textColor: "text-pink-500",
        cta: "Sígueme en TikTok",
    },
    {
        name: "YouTube",
        url: "https://youtube.com/@pereidax86",
        color: "border-red-600",
        textColor: "text-red-600",
        cta: "Suscríbete en YouTube",
    },
    {
        name: "Instagram",
        url: "https://instagram.com/pereidax86",
        color: "border-purple-500",
        textColor: "text-purple-500",
        cta: "Sígueme en Instagram",
    },
    {
        name: "LinkedIn",
        url: "https://linkedin.com/in/pereidax86",
        color: "border-blue-600",
        textColor: "text-blue-600",
        cta: "Conecta en LinkedIn",
    },
    {
        name: "Twitch",
        url: "https://twitch.tv/pereidax86",
        color: "border-purple-600",
        textColor: "text-purple-600",
        cta: "Sígueme en Twitch",
    },
];

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
---

{
  !isHome && (
    <aside
        id="floating-banner"
        aria-label="Sugerencia de redes sociales"
        class="fixed bottom-4 left-4 right-4 sm:right-auto z-50 hidden flex-row items-center gap-4 apple-glass p-4 pr-8 rounded-2xl shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-10 opacity-0 max-w-[calc(100vw-2rem)] sm:max-w-sm"
    >
    <!-- Botón de Cerrar (Área táctil mínima de 44x44px) -->
    <button
        id="close-banner"
        type="button"
        class="absolute -top-3 -right-3 w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center bg-neutral-800 text-gray-300 hover:text-white hover:bg-red-500/20 hover:border-red-500/50 rounded-full border border-neutral-700 shadow-md transition-all cursor-pointer"
        aria-label="Cerrar sugerencia"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <!-- Video Circular -->
    <div class="relative w-20 h-20 shrink-0" aria-hidden="true">
        <div
            id="video-border"
            class="absolute -inset-1 rounded-full border-2 animate-pulse"
        >
        </div>
        <div
            class="w-full h-full rounded-full overflow-hidden border-2 border-neutral-900 bg-black shadow-inner"
        >
            <video
                id="floating-banner-video"
                src="/video/subscribete.mp4"
                class="w-full h-full object-cover transform scale-110"
                preload="none"
                loop
                muted
                playsinline></video>
        </div>
    </div>

    <!-- Texto y CTA -->
    <div class="flex flex-col max-w-[240px] min-w-0">
        <p class="text-sm text-gray-300 font-medium leading-tight mb-1.5">
            ¿Quieres seguir aprendiendo?
        </p>
        <a
            id="social-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base font-bold hover:underline decoration-2 underline-offset-2 transition-all leading-snug"
        >
            <!-- Se llena con JS -->
        </a>
        <p class="text-xs text-gray-400 leading-tight mt-1">
            y no te pierdas nada.
        </p>
    </div>
</aside>
  )
}

<script define:vars={{ socialNetworks }}>
    const banner = document.getElementById("floating-banner");
    const closeBtn = document.getElementById("close-banner");
    const socialLink = document.getElementById("social-link");
    const videoBorder = document.getElementById("video-border");
    const bannerVideo = document.getElementById("floating-banner-video");
    
    // Configuración
    const BANNER_DELAY = 5000; // 5 segundos
    const shouldShow = true;

    if (shouldShow) {
        // Seleccionar red social aleatoria
        const randomSocial =
            socialNetworks[Math.floor(Math.random() * socialNetworks.length)];

        // Configurar contenido
        if (socialLink && videoBorder) {
            socialLink.href = randomSocial.url;
            socialLink.textContent = randomSocial.cta;
            socialLink.classList.add(randomSocial.textColor);
            videoBorder.classList.add(randomSocial.color);
        }

        // Mostrar baner con delay y reproducir video solo cuando sea visible
        setTimeout(() => {
            if (banner) {
                banner.classList.remove("hidden");
                document.body.dataset.floatingBannerVisible = "true";
                if (bannerVideo && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    bannerVideo.play().catch(() => {});
                }
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        banner.classList.remove("translate-y-10", "opacity-0");
                    });
                });
            }
        }, BANNER_DELAY);
    }

    // Manejar cierre (salida más rápida que la entrada: 250ms vs 500ms)
    if (closeBtn && banner) {
        closeBtn.addEventListener("click", () => {
            // Ocultar visualmente y pausar decodificación de video
            banner.classList.remove("duration-500");
            banner.classList.add("duration-200", "translate-y-20", "opacity-0");
            delete document.body.dataset.floatingBannerVisible;
            if (bannerVideo) {
                bannerVideo.pause();
            }

            // Esperar animación y ocultar del DOM
            setTimeout(() => {
                banner.classList.add("hidden");
            }, 200);
        });
    }
</script>

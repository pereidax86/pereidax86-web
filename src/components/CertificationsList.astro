---
import { Image } from "astro:assets";

interface CertMeta {
	id: string;
	label: string;
}

interface CertItem {
	name: string;
	image: ImageMetadata;
	url: string;
	isCredly?: boolean;
	meta?: CertMeta;
}

interface Props {
	certTop: CertItem;
	certsMiddle: CertItem[];
	certBottom: CertItem;
}

const { certTop, certsMiddle, certBottom } = Astro.props;

const allCerts = [certTop, ...certsMiddle, certBottom];
---

<div
	class="w-full h-full bg-neutral-900/50 backdrop-blur-sm border border-neutral-800 rounded-2xl p-6 lg:p-8 flex flex-col justify-between space-y-4"
>
	<div class="border-b border-neutral-800/80 pb-4">
		<h3 class="text-sm lg:text-base font-mono font-bold text-white uppercase tracking-wider">
			Certificaciones Oficiales
		</h3>
	</div>

	<div class="flex flex-col gap-3 flex-1 justify-around">
		{
			allCerts.map((cert) => (
				<a
					href={cert.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-4 p-3.5 lg:p-4 rounded-xl bg-neutral-950/60 border border-neutral-800/60 hover:border-blue-500/50 hover:bg-neutral-900/80 transition-all duration-300 shadow-md"
				>
					<div class="w-12 h-12 lg:w-14 lg:h-14 flex-shrink-0 flex items-center justify-center relative">
						<Image
							src={cert.image}
							alt={cert.name}
							class="w-full h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform"
						/>
					</div>
					<div class="flex-1 min-w-0">
						<h4 class="text-sm lg:text-base font-bold text-gray-100 group-hover:text-blue-400 transition-colors leading-snug">
							{cert.name}
						</h4>
						{cert.meta ? (
							<p class="text-xs lg:text-sm font-mono text-gray-400 mt-1">
								{cert.meta.label}: <span class="text-blue-400 font-semibold">{cert.meta.id}</span>
							</p>
						) : (
							<span class="text-xs lg:text-sm font-mono text-purple-400 group-hover:underline block mt-1">
								Verificar badge →
							</span>
						)}
					</div>
				</a>
			))
		}
	</div>
</div>

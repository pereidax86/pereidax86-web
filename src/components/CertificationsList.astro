---
import { Image } from "astro:assets";

interface CertMeta {
	id: string;
	label: string;
}

interface CertItem {
	name: string;
	image: ImageMetadata;
	url: string;
	isCredly?: boolean;
	meta?: CertMeta;
}

interface Props {
	certTop: CertItem;
	certsMiddle: CertItem[];
	certBottom: CertItem;
}

const { certTop, certsMiddle, certBottom } = Astro.props;

const allCerts = [certTop, ...certsMiddle, certBottom];
---

<div
	class="w-full h-full bg-neutral-900/50 backdrop-blur-sm border border-neutral-800 rounded-2xl p-5 sm:p-6 2xl:p-8 flex flex-col justify-between space-y-3 sm:space-y-4"
>
	<div class="border-b border-neutral-800/80 pb-3">
		<h3 class="text-xs sm:text-sm 2xl:text-base font-mono font-bold text-white uppercase tracking-wider">
			Certificaciones Oficiales
		</h3>
	</div>

	<div class="flex flex-col gap-2.5 sm:gap-3 flex-1 justify-around">
		{
			allCerts.map((cert) => (
				<a
					href={cert.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-3 p-3 2xl:p-4 rounded-xl bg-neutral-950/60 border border-neutral-800/60 hover:border-blue-500/50 hover:bg-neutral-900/80 transition-all duration-300 shadow-md"
				>
					<div class="w-10 h-10 sm:w-12 sm:h-12 2xl:w-14 2xl:h-14 flex-shrink-0 flex items-center justify-center relative">
						<Image
							src={cert.image}
							alt={cert.name}
							class="w-full h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform"
						/>
					</div>
					<div class="flex-1 min-w-0">
						<h4 class="text-xs sm:text-sm 2xl:text-base font-bold text-gray-100 group-hover:text-blue-400 transition-colors leading-tight">
							{cert.name}
						</h4>
						{cert.meta && (
							<p class="text-xs 2xl:text-sm font-mono text-blue-400 font-semibold mt-0.5">
								{cert.meta.id}
							</p>
						)}
					</div>
				</a>
			))
		}
	</div>
</div>

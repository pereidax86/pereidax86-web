---
interface Props {
	philosophy: string;
}

const { philosophy } = Astro.props;
---

<div
	class="w-full bg-neutral-900/40 border-l-4 border-purple-600 rounded-r-2xl p-6 lg:p-8 italic text-gray-300 text-base lg:text-lg leading-relaxed shadow-lg backdrop-blur-sm text-center"
>
	<span class="block text-purple-400 font-bold text-xs lg:text-sm not-italic mb-2 uppercase tracking-wider font-mono text-center">
		Mi Filosofía
	</span>
	"{philosophy}"
</div>

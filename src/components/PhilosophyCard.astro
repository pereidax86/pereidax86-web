---
interface Props {
	philosophy: string;
}

const { philosophy } = Astro.props;
---

<div
	class="w-full apple-glass border-l-4 border-purple-500 rounded-r-2xl p-4 sm:p-5 2xl:p-6 italic text-gray-300 text-xs sm:text-sm 2xl:text-base leading-relaxed shadow-xl text-center"
>
	<span class="block text-purple-400 font-bold text-xs not-italic mb-1.5 uppercase tracking-wider font-mono text-center">
		Mi Filosofía
	</span>
	"{philosophy}"
</div>

---
import CheatsheetCard from "./CheatsheetCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	cheatsheets: CollectionEntry<"cheatsheets">[];
}

const { cheatsheets } = Astro.props;
---

<div class="w-full pt-8 pb-12 flex flex-col items-center gap-6">
	<h2 class="text-2xl md:text-3xl font-bold text-white text-center">
		⚡ Guías Rápidas de Supervivencia ⚡
	</h2>
	<p class="text-sm text-gray-400 text-center max-w-lg">
		Aprende lo esencial sin el miedo existencial. Guías prácticas con ejercicios, pro tips y hasta
		anécdotas. Todo en un mismo lugar.
	</p>

	{/* Grid de cheatsheets */}
	{
		cheatsheets.length > 0 ? (
			<div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{cheatsheets.map((cheatsheet) => (
					<CheatsheetCard
						title={cheatsheet.data.title}
						description={cheatsheet.data.description}
						difficulty={cheatsheet.data.difficulty}
						icon={cheatsheet.data.icon}
						slug={cheatsheet.slug}
						tags={cheatsheet.data.tags}
						shortName={cheatsheet.data.shortName}
					/>
				))}
			</div>
		) : null
	}

	<a
		href="/cheatsheets"
		class="text-blue-400 hover:text-blue-300 font-mono text-sm transition-colors flex items-center gap-2"
	>
		<span>Ver todas las guías</span>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="w-4 h-4"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
			></path>
		</svg>
	</a>
</div>

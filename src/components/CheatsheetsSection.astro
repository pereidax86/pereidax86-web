---
import CheatsheetCard from "./CheatsheetCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	cheatsheets: CollectionEntry<"cheatsheets">[];
}

const { cheatsheets } = Astro.props;
---

<div class="w-full apple-glass rounded-2xl p-5 sm:p-6 2xl:p-8 flex flex-col justify-between h-full shadow-2xl gap-4 sm:gap-6">
	<div class="text-center space-y-1">
		<h2 class="text-2xl md:text-3xl font-extrabold text-white text-center tracking-[-0.03em] font-display">
			⚡ Guías Rápidas
		</h2>
		<p class="text-sm text-gray-400 font-mono">
			Aprende lo esencial en terminal, Linux y sysadmin
		</p>
	</div>

	{/* Lista vertical de cheatsheets */}
	<div class="w-full flex flex-col gap-4 flex-1 justify-start">
		{cheatsheets.map((cheatsheet) => (
			<a
				href={`/cheatsheets/${cheatsheet.slug}`}
				class="group flex items-center justify-between p-4 apple-glass-interactive rounded-xl hover:border-blue-500/50 active:scale-[0.98] transition-all duration-200"
			>
				<div class="flex items-center gap-3 min-w-0">
					<span class="text-2xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
						{cheatsheet.data.icon || "⚡"}
					</span>
					<div class="min-w-0">
						<h3 class="text-sm font-bold text-gray-200 group-hover:text-blue-400 transition-colors truncate">
							{cheatsheet.data.title}
						</h3>
						<p class="text-xs text-gray-400 line-clamp-1">
							{cheatsheet.data.description}
						</p>
					</div>
				</div>
				<span class="text-xs font-mono text-blue-400 flex-shrink-0 ml-2 group-hover:translate-x-1 transition-transform">
					Ver →
				</span>
			</a>
		))}

		{cheatsheets.length === 0 && (
			<div class="p-6 text-center border border-dashed border-neutral-800/80 rounded-xl text-gray-500 font-mono text-xs">
				No hay guías disponibles.
			</div>
		)}
	</div>

	<div class="text-center pt-2 border-t border-neutral-800/60">
		<a href="/cheatsheets" class="text-xs lg:text-sm font-mono text-blue-400 hover:text-blue-300 hover:underline">
			Ver todas las guías →
		</a>
	</div>
</div>

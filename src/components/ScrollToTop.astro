---
// ScrollToTop Component
---

<button
	id="scroll-top-btn"
	aria-label="Volver arriba"
	class="fixed bottom-8 right-8 p-3.5 apple-glass-interactive text-white rounded-full shadow-2xl transition-all duration-300 active:scale-90 transform translate-y-20 opacity-0 z-50 group cursor-pointer"
>
	<svg
		class="w-6 h-6 group-hover:-translate-y-1 transition-transform"
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
	</svg>
</button>

<script>
	const scrollBtn = document.getElementById("scroll-top-btn");

	function getScrollPos() {
		const mainContainer = document.getElementById("main-scroll-container");
		return mainContainer ? mainContainer.scrollTop : window.scrollY;
	}

	function updateBtnVisibility() {
		if (getScrollPos() > 300) {
			scrollBtn?.classList.remove("translate-y-20", "opacity-0");
			scrollBtn?.classList.add("translate-y-0", "opacity-100");
		} else {
			scrollBtn?.classList.add("translate-y-20", "opacity-0");
			scrollBtn?.classList.remove("translate-y-0", "opacity-100");
		}
	}

	window.addEventListener("scroll", updateBtnVisibility, { passive: true });
	document.addEventListener("DOMContentLoaded", () => {
		const mainContainer = document.getElementById("main-scroll-container");
		if (mainContainer) {
			mainContainer.addEventListener("scroll", updateBtnVisibility, { passive: true });
		}
	});

	scrollBtn?.addEventListener("click", () => {
		const mainContainer = document.getElementById("main-scroll-container");
		if (mainContainer) {
			mainContainer.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		}
		window.scrollTo({
			top: 0,
			behavior: "smooth",
		});
	});
</script>

---
// ScrollToTop Component
---

<button
	id="scroll-top-btn"
	type="button"
	aria-label="Volver arriba"
	aria-hidden="true"
	tabindex="-1"
	class="fixed bottom-6 right-4 sm:bottom-8 sm:right-8 w-12 h-12 min-w-[48px] min-h-[48px] flex items-center justify-center apple-glass-interactive text-white rounded-full shadow-2xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-90 transform translate-y-20 opacity-0 pointer-events-none z-50 group cursor-pointer"
>
	<svg
		class="w-6 h-6 group-hover:-translate-y-1 transition-transform"
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
	</svg>
</button>

<script>
	const scrollBtn = document.getElementById("scroll-top-btn");

	function getScrollPos() {
		const mainContainer = document.getElementById("main-scroll-container");
		return mainContainer ? mainContainer.scrollTop : window.scrollY;
	}

	function updateBtnVisibility() {
		if (!scrollBtn) return;
		if (getScrollPos() > 300) {
			scrollBtn.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
			scrollBtn.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
			scrollBtn.removeAttribute("aria-hidden");
			scrollBtn.removeAttribute("tabindex");
		} else {
			scrollBtn.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
			scrollBtn.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
			scrollBtn.setAttribute("aria-hidden", "true");
			scrollBtn.setAttribute("tabindex", "-1");
		}
	}

	window.addEventListener("scroll", updateBtnVisibility, { passive: true });
	document.addEventListener("DOMContentLoaded", () => {
		const mainContainer = document.getElementById("main-scroll-container");
		if (mainContainer) {
			mainContainer.addEventListener("scroll", updateBtnVisibility, { passive: true });
		}
	});

	scrollBtn?.addEventListener("click", () => {
		const scrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
		const mainContainer = document.getElementById("main-scroll-container");
		if (mainContainer) {
			mainContainer.scrollTo({
				top: 0,
				behavior: scrollBehavior,
			});
		}
		window.scrollTo({
			top: 0,
			behavior: scrollBehavior,
		});
	});
</script>

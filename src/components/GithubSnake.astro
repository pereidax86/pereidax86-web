---
// GithubSnake Component - Retro Terminal Style
---

<div class="w-full max-w-3xl mx-auto my-6">
	<div class="bg-neutral-950 border border-neutral-800/80 rounded-xl overflow-hidden shadow-2xl hover:border-blue-500/30 transition-colors">
		{/* TERMINAL HEADER BAR */}
		<div class="bg-neutral-900/90 px-4 py-2.5 border-b border-neutral-800/80 flex items-center justify-between">
			<div class="flex items-center gap-2">
				<span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
				<span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
				<span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
			</div>
			<span class="text-xs font-mono text-gray-400 font-semibold tracking-wider">
				/var/log/github-activity
			</span>
			<span class="text-[10px] font-mono text-green-400 bg-green-500/10 px-2 py-0.5 rounded border border-green-500/20">
				ACTIVE
			</span>
		</div>

		{/* TERMINAL BODY WITH SNAKE ANIMATION */}
		<div class="p-4 flex flex-col items-center bg-neutral-950/90">
			<img
				src="https://raw.githubusercontent.com/pereidax86/pereidax86/output/github-contribution-grid-snake-dark.svg"
				alt="GitHub Snake Activity"
				class="w-full opacity-90 hover:opacity-100 transition-opacity duration-500"
			/>
		</div>
	</div>
</div>

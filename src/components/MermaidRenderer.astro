---
// Shared Mermaid Diagram Renderer (Loads Mermaid dynamically only when diagrams exist on the page)
---

<style is:global>
  .mermaid svg {
    overflow: visible !important;
    max-width: 100% !important;
    height: auto !important;
  }
  .mermaid .node {
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.75));
  }
  .mermaid .node rect,
  .mermaid .node circle,
  .mermaid .node polygon,
  .mermaid .node path,
  .mermaid .label-container,
  .mermaid .basic.node,
  .mermaid .basic.node rect,
  .mermaid .block {
    fill: #171717 !important;
    stroke: #ffffff !important;
    stroke-width: 1.5px !important;
  }
  .mermaid .edgePath .path,
  .mermaid .flowchart-link,
  .mermaid .edgePaths path,
  .mermaid path.path {
    stroke: #ffffff !important;
    stroke-width: 2px !important;
  }
  .mermaid .marker,
  .mermaid marker path,
  .mermaid #arrowhead path,
  .mermaid .arrowheadPath {
    fill: #ffffff !important;
    stroke: #ffffff !important;
  }
  .mermaid text,
  .mermaid .nodeLabel,
  .mermaid .edgeLabel,
  .mermaid p,
  .mermaid span,
  .mermaid div {
    fill: #ffffff !important;
    color: #ffffff !important;
    font-family: inherit !important;
  }
</style>

<script>
  const MERMAID_SELECTOR =
    '[data-language="mermaid"], [data-lang="mermaid"], .language-mermaid, pre.astro-code[data-language="mermaid"]';

  async function initMermaidOnDemand() {
    const rawBlocks = Array.from(document.querySelectorAll(MERMAID_SELECTOR));
    if (rawBlocks.length === 0) return;

    const targetBlocks = Array.from(
      new Set(
        rawBlocks.map((el) =>
          el.tagName === "PRE" ? el : el.closest("pre") || el
        )
      )
    ).filter((el) => !el.hasAttribute("data-mermaid-rendered"));

    if (targetBlocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      theme: "dark",
      securityLevel: "loose",
      fontFamily: "inherit",
      themeVariables: {
        primaryColor: "#171717",
        primaryTextColor: "#ffffff",
        primaryBorderColor: "#ffffff",
        lineColor: "#ffffff",
        textColor: "#ffffff",
        edgeLabelBackground: "#171717",
        nodeBorder: "#ffffff",
        clusterBorders: "#ffffff",
        mainBkg: "#171717",
        fontFamily: "inherit",
      },
    });

    for (let i = 0; i < targetBlocks.length; i++) {
      const targetPre = targetBlocks[i];
      if (targetPre.hasAttribute("data-mermaid-rendered")) continue;

      const lineElements = targetPre.querySelectorAll(".line");
      let codeText = "";
      if (lineElements.length > 0) {
        codeText = Array.from(lineElements)
          .map((el) => el.textContent)
          .join("\n");
      } else {
        codeText = targetPre.textContent || "";
      }

      codeText = codeText.trim();
      if (!codeText) continue;

      try {
        const id = `mermaid-svg-${Date.now()}-${i}`;
        const { svg } = await mermaid.render(id, codeText);

        const container = document.createElement("div");
        container.className =
          "mermaid flex justify-center my-8 overflow-x-auto p-6 bg-neutral-900/80 border border-neutral-800 rounded-2xl shadow-2xl shadow-black/60";
        container.innerHTML = svg;

        targetPre.setAttribute("data-mermaid-rendered", "true");
        targetPre.replaceWith(container);
      } catch (error) {
        console.error(`[Mermaid] Error rendering diagram #${i}:`, error);
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMermaidOnDemand);
  } else {
    initMermaidOnDemand();
  }

  document.addEventListener("astro:page-load", initMermaidOnDemand);
</script>

---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export interface Props {
  currentSlug: string;
  currentTags: string[];
  allPosts: CollectionEntry<"blog">[];
  limit?: number;
}

const { currentSlug, currentTags = [], allPosts, limit = 3 } = Astro.props;

// Filtrar el post actual y los borradores
const otherPosts = allPosts.filter(
  (post) => post.slug !== currentSlug && !post.data.draft
);

// Calcular coincidencia de etiquetas (tags)
const scoredPosts = otherPosts.map((post) => {
  const postTags = post.data.tags || [];
  const overlap = postTags.filter((tag) => currentTags.includes(tag)).length;
  return { post, overlap };
});

// Ordenar: primero por más etiquetas coincidentes, luego por fecha más reciente
scoredPosts.sort((a, b) => {
  if (b.overlap !== a.overlap) {
    return b.overlap - a.overlap;
  }
  return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const relatedPosts = scoredPosts.slice(0, limit).map((item) => item.post);
---

{
  relatedPosts.length > 0 && (
    <section class="mt-16 pt-10 border-t border-neutral-800">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-2">
            <span>📚</span> Artículos Relacionados
          </h2>
          <p class="text-xs text-gray-400 font-mono mt-1">
            Continúa explorando temas de Linux, Ciberseguridad y Open Source
          </p>
        </div>
        <a
          href="/blog"
          class="hidden sm:inline-flex items-center gap-1 text-xs font-mono text-blue-400 hover:text-blue-300 hover:underline"
        >
          Ver todo el blog →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col bg-neutral-900/50 hover:bg-neutral-900 border border-neutral-800 hover:border-blue-500/40 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-500/5"
          >
            {post.data.image && (
              <div class="w-full h-40 overflow-hidden bg-neutral-950">
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-5 flex flex-col flex-grow justify-between">
              <div>
                <span class="text-[10px] font-mono text-purple-400 uppercase tracking-wider block mb-2">
                  {post.data.pubDate.toLocaleDateString("es-MX", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
                <h3 class="font-bold text-gray-200 group-hover:text-blue-400 transition-colors line-clamp-2 text-sm leading-snug">
                  {post.data.title}
                </h3>
              </div>
              <div class="mt-4 pt-3 border-t border-neutral-800/60 flex items-center justify-between text-xs font-mono text-gray-500 group-hover:text-blue-400/80">
                <span>Leer artículo</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

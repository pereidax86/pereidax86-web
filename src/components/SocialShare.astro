---
export interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;

// Construir la URL completa
const currentUrl = url || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(`"${title}" por @pereidax86`);

const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const whatsappShareUrl = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
---

{/* --- BLOQUE DESTACADO AL FINAL DEL ARTÍCULO (Desktop & Móviles) --- */}
<div
  id="social-share-footer-banner"
  class="my-10 p-6 bg-neutral-900/40 rounded-2xl border border-neutral-800 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl"
>
  <div class="text-center md:text-left">
    <h3 class="text-lg font-bold text-white flex items-center justify-center md:justify-start gap-2">
      <span>📢</span> ¿Te sirvió este artículo?
    </h3>
    <p class="text-sm text-gray-400 mt-1">
      Ayúdame a difundirlo compartiéndolo con otros profesionales y entusiastas.
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-3">
    {/* Botón X (Twitter) */}
    <a
      href={twitterShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2.5 bg-neutral-950 hover:bg-black text-gray-300 hover:text-white rounded-xl font-mono text-xs font-bold border border-neutral-800 hover:border-neutral-600 transition-all hover:scale-105"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>X (Twitter)</span>
    </a>

    {/* Botón LinkedIn */}
    <a
      href={linkedinShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2.5 bg-neutral-950 hover:bg-blue-950/40 text-gray-300 hover:text-blue-400 rounded-xl font-mono text-xs font-bold border border-neutral-800 hover:border-blue-500/50 transition-all hover:scale-105"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9z"/>
      </svg>
      <span>LinkedIn</span>
    </a>

    {/* Botón WhatsApp */}
    <a
      href={whatsappShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2.5 bg-neutral-950 hover:bg-green-950/40 text-gray-300 hover:text-green-400 rounded-xl font-mono text-xs font-bold border border-neutral-800 hover:border-green-500/50 transition-all hover:scale-105"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    {/* Botón Principal (Nativo Web Share en móvil / Copiar Enlace en desktop) */}
    <button
      id="main-share-btn"
      data-title={title}
      data-url={currentUrl}
      class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-mono text-xs font-bold transition-all hover:scale-105 shadow-md shadow-blue-500/20 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
      </svg>
      <span id="main-share-btn-text">Compartir</span>
    </button>
  </div>
</div>

{/* --- 3. TOAST FLOTANTE NOTIFICACIÓN COPIADO AL PORTAPAPELES --- */}
<div
  id="copy-toast"
  class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2.5 px-5 py-3 bg-neutral-900/90 text-blue-400 font-mono text-xs font-bold rounded-2xl border border-blue-500/50 shadow-2xl backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
>
  <span class="text-base">✅</span>
  <span>¡Enlace copiado al portapapeles!</span>
</div>

<script>
  function setupSocialShare() {
    const sidebar = document.getElementById("social-share-sidebar");
    const footerBanner = document.getElementById("social-share-footer-banner");
    const copyToast = document.getElementById("copy-toast");

    const mainShareBtn = document.getElementById("main-share-btn");
    const mainShareBtnText = document.getElementById("main-share-btn-text");
    const sidebarCopyBtn = document.getElementById("sidebar-copy-btn");

    let isFooterIntersecting = false;
    let toastTimeout: ReturnType<typeof setTimeout> | null = null;

    // --- LÓGICA 1: MOSTRAR/OCULTAR BARRA FLOTANTE SEGÚN SCROLL ---
    function updateSidebarVisibility() {
      if (!sidebar) return;

      // La barra lateral está visible desde el inicio y al volver a subir. Solo se oculta al llegar al banner del final.
      if (isFooterIntersecting) {
        sidebar.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        sidebar.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      } else {
        sidebar.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
        sidebar.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      }
    }

    // Observer para saber cuándo el banner final entra en pantalla
    if (footerBanner && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isFooterIntersecting = entry.isIntersecting;
            updateSidebarVisibility();
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(footerBanner);
    }

    window.addEventListener("scroll", updateSidebarVisibility, { passive: true });
    updateSidebarVisibility();

    // --- LÓGICA 2: TOAST SUAVE AL COPIAR ENLACE (SIN ALERT) ---
    function showToast() {
      if (!copyToast) return;
      if (toastTimeout) clearTimeout(toastTimeout);

      copyToast.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
      copyToast.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");

      toastTimeout = setTimeout(() => {
        copyToast.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        copyToast.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      }, 2500);
    }

    // Lógica para el botón de la barra lateral flotante
    sidebarCopyBtn?.addEventListener("click", async () => {
      const shareUrl = sidebarCopyBtn.getAttribute("data-url") || window.location.href;
      try {
        await navigator.clipboard.writeText(shareUrl);
        
        // Animación temporal en el botón de la barra lateral
        sidebarCopyBtn.classList.add("text-blue-400", "border-blue-500");
        setTimeout(() => {
          sidebarCopyBtn.classList.remove("text-blue-400", "border-blue-500");
        }, 2000);

        showToast();
      } catch (err) {
        console.error("Error al copiar al portapapeles", err);
      }
    });

    // Lógica para el botón principal del banner (Nativo Web Share en móvil / Toast en desktop)
    mainShareBtn?.addEventListener("click", async () => {
      const shareTitle = mainShareBtn.getAttribute("data-title") || document.title;
      const shareUrl = mainShareBtn.getAttribute("data-url") || window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({
            title: shareTitle,
            text: `Mira este artículo de @pereidax86: ${shareTitle}`,
            url: shareUrl,
          });
        } catch (err) {
          // Usuario canceló compartir
        }
      } else {
        try {
          await navigator.clipboard.writeText(shareUrl);
          if (mainShareBtnText) {
            const originalText = mainShareBtnText.innerText;
            mainShareBtnText.innerText = "✅ ¡Enlace Copiado!";
            setTimeout(() => {
              mainShareBtnText.innerText = originalText;
            }, 2500);
          }
          showToast();
        } catch (err) {
          console.error("Error al copiar al portapapeles", err);
        }
      }
    });
  }

  setupSocialShare();
</script>

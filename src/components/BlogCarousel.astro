---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<div class="w-full pt-2 pb-8 flex flex-col items-center gap-6">
	<div class="text-center space-y-2">
		<div class="flex items-center justify-center gap-3">
			<h2 class="text-2xl md:text-3xl font-extrabold text-white text-center tracking-[-0.03em] font-display">Bitácora del sysadmin</h2>
			<a
				href="/rss.xml"
				target="_blank"
				title="Suscríbete al Feed RSS"
				class="group relative inline-flex items-center justify-center p-2.5 apple-glass-interactive rounded-xl hover:border-orange-500/50 transition-all active:scale-95"
			>
				<div
					class="absolute -inset-0.5 bg-gradient-to-r from-orange-600 to-amber-500 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"
				>
				</div>
				<svg
					class="relative w-5 h-5 text-orange-500 group-hover:scale-110 transition-transform fill-current duration-200"
					viewBox="0 0 24 24"
				>
					<path
						d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"
					></path>
				</svg>
			</a>
		</div>
		<p class="text-sm text-gray-400 font-mono max-w-xl mx-auto">
			Historias desde mi teclado: experiencias y reflexiones de cosas que he vivido, me llaman la atención o me parecen interesantes.
		</p>
	</div>

	<div class="w-full relative group px-4 md:px-12">
		{/* Botón Izquierdo */}
		<button
			id="carousel-prev"
			class="absolute left-0 top-1/2 -translate-y-1/2 z-10 p-2.5 apple-glass-interactive rounded-full text-white hover:border-blue-500 transition-all hidden md:flex items-center justify-center shadow-xl active:scale-90"
			aria-label="Anterior"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-6 h-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
				></path>
			</svg>
		</button>

		{/* Scroll Container */}
		<div
			id="carousel-container"
			class="flex overflow-x-auto gap-4 py-4 px-2 snap-x snap-mandatory scrollbar-hide scroll-smooth [mask-image:linear-gradient(to_right,transparent,black_40px,black_calc(100%-40px),transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_40px,black_calc(100%-40px),transparent)]"
		>
			{
				posts.map((post) => (
					<a
						href={`/blog/${post.slug}`}
						class="snap-center shrink-0 w-[270px] sm:w-80 md:w-96 first:pl-2 last:pr-2 block hover:scale-[1.02] active:scale-[0.98] transition-transform duration-200"
					>
						<article class="h-full apple-glass-interactive rounded-xl overflow-hidden hover:border-blue-500/40 flex flex-col shadow-xl">
							<div class="relative aspect-video overflow-hidden">
								{post.data.image ? (
									<Image
										src={post.data.image}
										alt={post.data.title}
										class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center bg-neutral-900">
										<span class="text-4xl">🐧</span>
									</div>
								)}
								<div class="absolute inset-0 bg-gradient-to-t from-neutral-900/90 to-transparent" />
							</div>
							<div class="p-4 flex flex-col flex-1 gap-2">
								<h4 class="text-white font-bold leading-tight line-clamp-2">
									{post.data.title}
								</h4>
								<p class="text-gray-400 text-sm line-clamp-2 flex-1">
									{post.data.description}
								</p>
								<div class="flex items-center justify-between mt-auto pt-2 text-xs font-mono text-blue-400">
									<span>{post.data.pubDate.toLocaleDateString()}</span>
									<span class="group-hover:translate-x-1 transition-transform">
										Leer más →
									</span>
								</div>
							</div>
						</article>
					</a>
				))
			}
		</div>

		{/* Botón Derecho */}
		<button
			id="carousel-next"
			class="absolute right-0 top-1/2 -translate-y-1/2 z-10 p-2.5 apple-glass-interactive rounded-full text-white hover:border-blue-500 transition-all hidden md:flex items-center justify-center shadow-xl active:scale-90"
			aria-label="Siguiente"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-6 h-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
				></path>
			</svg>
		</button>
	</div>

	{/* Enlace para ver todas las publicaciones */}
	<div class="text-center pt-1">
		<a
			href="/blog"
			class="inline-flex items-center gap-2 text-sm font-mono font-bold text-blue-400 hover:text-blue-300 hover:underline transition-colors"
		>
			Ver todas las publicaciones →
		</a>
	</div>
</div>

<script>
	const container = document.getElementById("carousel-container");
	const prevBtn = document.getElementById("carousel-prev");
	const nextBtn = document.getElementById("carousel-next");

	if (container && prevBtn && nextBtn) {
		const scrollAmount = 380;
		let isUserInteracting = false;

		prevBtn.addEventListener("click", () => {
			container.scrollBy({
				left: -scrollAmount,
				behavior: "smooth",
			});
		});

		nextBtn.addEventListener("click", () => {
			container.scrollBy({
				left: scrollAmount,
				behavior: "smooth",
			});
		});

		// Auto-play timer (advance every 4 seconds unless hovered/touched)
		container.addEventListener("mouseenter", () => (isUserInteracting = true));
		container.addEventListener("mouseleave", () => (isUserInteracting = false));
		container.addEventListener("touchstart", () => (isUserInteracting = true), { passive: true });
		container.addEventListener("touchend", () => {
			setTimeout(() => (isUserInteracting = false), 2000);
		});

		setInterval(() => {
			if (!isUserInteracting) {
				const maxScrollLeft = container.scrollWidth - container.clientWidth;
				if (container.scrollLeft >= maxScrollLeft - 10) {
					container.scrollTo({ left: 0, behavior: "smooth" });
				} else {
					container.scrollBy({ left: scrollAmount, behavior: "smooth" });
				}
			}
		}, 4000);
	}
</script>

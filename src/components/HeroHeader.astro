---
import PhilosophyCard from "./PhilosophyCard.astro";
import CertificationsList from "./CertificationsList.astro";

interface TechItem {
	name: string;
	icon: string;
}

interface CertMeta {
	id: string;
	label: string;
}

interface CertItem {
	name: string;
	image: ImageMetadata;
	url: string;
	isCredly?: boolean;
	meta?: CertMeta;
}

interface Props {
	gravatarUrl: string;
	bioText: string;
	techStack: TechItem[];
	currentStatus: string;
	philosophy: string;
	certTop: CertItem;
	certsMiddle: CertItem[];
	certBottom: CertItem;
}

const { gravatarUrl, bioText, techStack, currentStatus, philosophy, certTop, certsMiddle, certBottom } = Astro.props;
---

{/* CONTENEDOR HERO PRINCIPAL RESPONSIVO */}
<div class="w-full max-w-7xl mx-auto flex flex-col lg:flex-row gap-6 xl:gap-8 2xl:gap-10 items-stretch justify-center">

	{/* PANTALLA 1 (MÓVIL & TABLET SNAP 1): PERFIL E IDENTIDAD HERO */}
	<section class="min-h-[100dvh] snap-start md:min-h-[100dvh] md:snap-start lg:min-h-0 lg:snap-none w-full lg:w-1/3 flex items-center justify-center p-2 sm:p-4 lg:p-0">
		<div class="w-full max-w-md md:max-w-xl lg:max-w-none flex flex-col items-center justify-center gap-4 sm:gap-6 text-center apple-glass rounded-2xl p-5 sm:p-6 2xl:p-8 shadow-2xl h-full">
			{/* GRAVATAR AVATAR & VIDEO ANIMATION */}
			<div class="relative w-36 h-36 sm:w-40 sm:h-40 xl:w-44 xl:h-44 2xl:w-52 2xl:h-52 group flex-shrink-0">
				<div
					class="absolute -inset-1 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-700 ease-out"
				>
				</div>
				<div class="relative w-full h-full rounded-full overflow-hidden border-4 border-neutral-950 shadow-2xl bg-neutral-900 active:scale-95 transition-transform duration-300">
					{/* Imagen de avatar inmediata (Fallback sin esperas) */}
					<img
						src={gravatarUrl}
						alt="Luis Pereida"
						class="absolute inset-0 w-full h-full object-cover rounded-full"
					/>
					{/* Video animado que se reproduce 1 sola vez y regresa suavemente a la imagen */}
					<video
						id="hero-avatar-video"
						src="/video/subscribete.mp4"
						class="absolute inset-0 w-full h-full object-cover rounded-full opacity-0 transition-opacity duration-700 ease-in-out cursor-pointer"
						autoplay
						muted
						playsinline
						poster={gravatarUrl}
					></video>
				</div>
				<div
					class="absolute bottom-2 right-2 bg-neutral-900/90 backdrop-blur-md rounded-full p-1.5 border border-neutral-800/80 shadow-lg z-10"
					title="SysAdmin Active"
				>
					<div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse ring-4 ring-blue-500/20"></div>
				</div>
			</div>

			{/* NOMBRES Y TITULOS */}
			<div class="space-y-1.5 flex flex-col items-center">
				<p class="text-sm sm:text-base xl:text-lg text-blue-400 font-mono font-bold text-center tracking-wide">
					Yo soy
				</p>
				<h1 class="text-3xl sm:text-4xl xl:text-4xl 2xl:text-6xl font-extrabold text-white tracking-[-0.035em] leading-[1.05] font-display">
					Luis Pereida
				</h1>
				<p
					class="text-sm sm:text-base xl:text-base 2xl:text-xl text-blue-400 font-mono font-bold text-center hover:text-white transition-colors duration-300 cursor-default mt-1"
					style="text-shadow: 0 0 20px rgba(59, 130, 246, 0.35);"
				>
					y hago ciberseguridad para todos
				</p>
				<p class="text-xs sm:text-sm xl:text-base text-gray-300 font-mono mt-0.5 tracking-wide h-6 flex items-center gap-1">
					<span id="typewriter" class="text-gray-200"></span>
					<span class="animate-pulse bg-blue-400 w-2 h-4 block"></span>
				</p>

				{/* STATUS BAR */}
				<div
					class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full apple-glass border-green-500/40 text-green-400 text-xs 2xl:text-sm font-mono mt-2 shadow-lg"
				>
					<span class="relative flex h-2.5 w-2.5">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
					</span>
					{currentStatus}
				</div>
			</div>
		</div>
	</section>

	{/* CONTENEDOR TABLET SNAP 2 (BIO/FILOSOFÍA + CERTS): Tablet Snap 2 | Móvil Snaps 2 & 3 | Desktop Cols 2 & 3 */}
	<div class="w-full lg:w-2/3 md:min-h-[100dvh] md:snap-start lg:snap-none lg:min-h-0 flex flex-col md:grid md:grid-cols-2 lg:flex lg:flex-row gap-6 items-stretch justify-center p-2 sm:p-4 lg:p-0">
		
		{/* CARD 2 (BIO & FILOSOFÍA): Móvil Snap 2 | Tablet Snap 2 Col 1 | Desktop Col 2 */}
		<section class="min-h-[100dvh] md:min-h-0 snap-start md:snap-none w-full lg:w-1/2 flex items-center justify-center">
			<div class="w-full max-w-md md:max-w-none flex flex-col justify-between gap-4 sm:gap-6 text-center h-full">
				{/* TARJETA DE BIO Y TECH STACK */}
				<div
					class="apple-glass rounded-2xl p-5 sm:p-6 2xl:p-8 text-gray-200 leading-relaxed text-xs sm:text-sm xl:text-sm 2xl:text-base font-mono text-center flex-1 flex flex-col justify-center gap-4 sm:gap-6 items-center shadow-xl"
				>
					<p class="text-center leading-relaxed text-gray-300">{bioText}</p>

					{/* TECH STACK PILLS */}
					<div class="flex flex-wrap justify-center gap-1.5 sm:gap-2 pt-4 sm:pt-6 border-t border-neutral-800/80 w-full">
						{
							techStack.map((tech) => (
								<span class="px-2.5 py-1 rounded-lg apple-glass-interactive text-xs 2xl:text-sm text-blue-300 font-bold hover:text-blue-200 cursor-default flex items-center gap-1.5 active:scale-95">
									<span>{tech.icon}</span>
									{tech.name}
								</span>
							))
						}
					</div>
				</div>

				{/* TARJETA DE FILOSOFÍA */}
				<PhilosophyCard philosophy={philosophy} />
			</div>
		</section>

		{/* CARD 3 (CERTIFICACIONES): Móvil Snap 3 | Tablet Snap 2 Col 2 | Desktop Col 3 */}
		<section class="min-h-[100dvh] md:min-h-0 snap-start md:snap-none w-full lg:w-1/2 flex items-center justify-center">
			<div class="w-full max-w-md md:max-w-none h-full">
				<CertificationsList certTop={certTop} certsMiddle={certsMiddle} certBottom={certBottom} />
			</div>
		</section>

	</div>
</div>

<script>
	const text = "@pereidax86";
	const typewriter = document.getElementById("typewriter");
	let i = 0;

	function type() {
		if (i < text.length) {
			if (typewriter) {
				typewriter.innerHTML += text.charAt(i);
			}
			i++;
			setTimeout(type, 100);
		}
	}

	setTimeout(type, 500);

	// Video Avatar Smooth Fade-In, Fade-Out al finalizar y Replay en Hover
	const avatarVideo = document.getElementById("hero-avatar-video") as HTMLVideoElement | null;
	const avatarContainer = avatarVideo?.parentElement;

	if (avatarVideo) {
		const showVideo = () => {
			avatarVideo.classList.remove("opacity-0");
			avatarVideo.classList.add("opacity-100");
		};

		const hideVideo = () => {
			avatarVideo.classList.remove("opacity-100");
			avatarVideo.classList.add("opacity-0");
		};

		if (avatarVideo.readyState >= 3) {
			showVideo();
		} else {
			avatarVideo.addEventListener("canplaythrough", showVideo, { once: true });
			avatarVideo.addEventListener("playing", showVideo, { once: true });
		}

		// Al finalizar la animación del video (1 sola reproducción), regresa suavemente a la imagen
		avatarVideo.addEventListener("ended", hideVideo);

		// Si el usuario pasa el mouse sobre el avatar, reproduce la animación de nuevo
		if (avatarContainer) {
			avatarContainer.addEventListener("mouseenter", () => {
				avatarVideo.currentTime = 0;
				showVideo();
				avatarVideo.play().catch(() => {});
			});
		}
	}
</script>

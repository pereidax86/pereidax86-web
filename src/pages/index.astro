                                class="text-[9px] text-gray-500 uppercase tracking-wider"
                                >{certTop.meta.label}</span
                            >
                            <span
                                class="text-[11px] font-mono text-blue-400 select-all cursor-text"
                                >{certTop.meta.id}</span
                            >
                        </div>
                    </div>
                </div>
            </div>

            {/* MIDDLE */}
            <div
                class="w-full grid grid-cols-3 gap-4 md:gap-8 justify-items-center max-w-lg"
            >

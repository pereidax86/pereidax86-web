---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

import HeroHeader from "../components/HeroHeader.astro";
import PhilosophyCard from "../components/PhilosophyCard.astro";
import CertificationsSection from "../components/CertificationsSection.astro";
import SocialGrid from "../components/SocialGrid.astro";
import CheatsheetsSection from "../components/CheatsheetsSection.astro";
import BlogCarousel from "../components/BlogCarousel.astro";
import NavigationLinks from "../components/NavigationLinks.astro";
import GithubSnake from "../components/GithubSnake.astro";

import cehBadge from "../assets/badges/CEH_2E345519D3F7.png";
import rhcsaBadge from "../assets/badges/rhcsa.png";
import rhVirtBadge from "../assets/badges/rh-virtualization.png";
import rhContBadge from "../assets/badges/rh-containers.png";
import ibmCloudBadge from "../assets/badges/ibm-cloud.png";

// --- BLOG DATA ---
const allPosts = await getCollection("blog");
const sortedPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

// --- CHEATSHEETS DATA ---
const allCheatsheets = await getCollection("cheatsheets");
const sortedCheatsheets = allCheatsheets
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// --- CONFIGURACIÓN ---
const GRAVATAR_HASH = "4949755b64eb223f0fa2b210aaf9707c";
const GRAVATAR_URL = `https://www.gravatar.com/avatar/${GRAVATAR_HASH}?s=400`;
const EMAIL_CONTACTO = "luis@pereidax86.com";

// --- DATOS DEL PERFIL ---
const pageTitle = "Luis Pereida | @pereidax86";
const bioText =
	"Ingeniero en Sistemas y Maestro en TIC. Me apasiona el Open Source y desmitificar la tecnología. Comparto lo que sé sobre Linux, Ciberseguridad, Inteligencia Artificial y todo lo que ocurre detrás de una terminal de pantalla negra y letras blancas.";

const techStack = [
	{ name: "Linux", icon: "🐧" },
	{ name: "Red Hat", icon: "🎩" },
	{ name: "Cybersecurity", icon: "🛡️" },
	{ name: "Python", icon: "🐍" },
	{ name: "AI & Automation", icon: "🤖" },
	{ name: "Podman", icon: "🦭" },
	{ name: "Open Source", icon: "🔓" },
	{ name: "Astro", icon: "🚀" },
	{ name: "Tailwind", icon: "🎨" },
];

const currentStatus = "🌱 Learning: CISSP & Advanced Red Teaming";
const philosophy =
	"Creo que cualquier concepto técnico complejo puede explicarse con una analogía simple. Mi meta es romper barreras y hacer el conocimiento accesible para todos.";

// --- CERTIFICACIONES ---
const certTop = {
	name: "Certified Ethical Hacker",
	image: cehBadge,
	url: "https://aspen.eccouncil.org/Verify",
	isCredly: false,
	meta: { id: "ECC3657809142", label: "ID Number" },
};

const certsMiddle = [
	{
		name: "RedHat Certified System Administrator",
		image: rhcsaBadge,
		url: "https://www.credly.com/badges/6701c173-e710-4c21-800a-ac6086ef59c1/public_url",
		isCredly: true,
	},
	{
		name: "RedHat Certified Specialist Virtualization",
		image: rhVirtBadge,
		url: "https://www.credly.com/badges/99a80d64-5d22-4944-bcf3-0e477eece1e6/public_url",
		isCredly: true,
	},
	{
		name: "RedHat Certified Specialist Containers",
		image: rhContBadge,
		url: "https://www.credly.com/badges/4f5dd55a-d796-44ad-af8d-d44f63ed4daa/public_url",
		isCredly: true,
	},
];

const certBottom = {
	name: "IBM Cloud Advocate v2",
	image: ibmCloudBadge,
	url: "https://www.credly.com/badges/6cb65f66-7a49-473f-a9cd-7015c12c4e05/public_url",
	isCredly: true,
};
---

<Layout title={pageTitle} description={bioText}>
	<main class="w-full max-w-2xl px-6 py-12 flex flex-col items-center gap-8 animate-fade-in">
		<HeroHeader
			gravatarUrl={GRAVATAR_URL}
			bioText={bioText}
			techStack={techStack}
			currentStatus={currentStatus}
		/>

		<hr class="w-full border-neutral-800/50" />

		<PhilosophyCard philosophy={philosophy} />

		<CertificationsSection certTop={certTop} certsMiddle={certsMiddle} certBottom={certBottom} />

		<SocialGrid />

		<hr class="w-full border-neutral-800/50" />

		<CheatsheetsSection cheatsheets={sortedCheatsheets} />

		<hr class="w-full border-neutral-800/50" />

		<BlogCarousel posts={sortedPosts} />

		<NavigationLinks emailContacto={EMAIL_CONTACTO} />
	</main>

	<GithubSnake />
</Layout>

                        />
                    </a>
                    <div class="flex flex-col items-center z-20">
                        <span
                            class="text-xs font-bold text-gray-200 group-hover:text-blue-400 transition-colors"
                            >{certTop.name}</span
                        >
                        <div
                            class="flex flex-col items-center mt-1 bg-neutral-950 px-3 py-1.5 rounded border border-neutral-800 group-hover:border-blue-500/30 transition-colors shadow-lg"

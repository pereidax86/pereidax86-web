                            ></path>
                        </svg>
                    </div>
                </a>

                {/* GitHub */}
                <a
                    href="https://github.com/pereidax86"
                    target="_blank"
                    class="group relative aspect-square"
                    title="GitHub"
                >
                    <div
                        class="absolute -inset-0.5 bg-gradient-to-r from-purple-600 to-purple-500 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"
                    >

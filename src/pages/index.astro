                </h2>
                <p class="text-sm text-gray-400">
                    Conecta conmigo en todas las plataformas
                </p>
            </div>

            {/* Grid de íconos */}
            <div
                class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-4 w-full max-w-4xl"
            >
                {/* TikTok */}
                <a
                    href="https://tiktok.com/@pereidax86"
                    target="_blank"
                    class="group relative aspect-square"
                    title="TikTok"
                >
                    <div
                        class="absolute -inset-0.5 bg-gradient-to-r from-pink-600 to-purple-600 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"
                    >
                    </div>
                    <div
                        class="relative h-full bg-neutral-900 rounded-xl border border-neutral-800 group-hover:border-pink-500/50 transition-all flex items-center justify-center group-hover:bg-neutral-800"
                    >
                        <svg
                            class="w-8 h-8 text-pink-500 group-hover:scale-110 transition-transform"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
                            ></path>
                        </svg>
                    </div>
                </a>

                {/* YouTube */}
                <a
                    href="https://youtube.com/@pereidax86"
                    target="_blank"
                    class="group relative aspect-square"
                    title="YouTube"
                >
                    <div
                        class="absolute -inset-0.5 bg-gradient-to-r from-red-600 to-red-500 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"
                    >
                    </div>
                    <div
                        class="relative h-full bg-neutral-900 rounded-xl border border-neutral-800 group-hover:border-red-500/50 transition-all flex items-center justify-center group-hover:bg-neutral-800"
                    >
                        <svg
                            class="w-8 h-8 text-red-500 group-hover:scale-110 transition-transform"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"

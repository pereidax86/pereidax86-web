                {/* Facebook */}
                <a
                    href="https://www.facebook.com/people/pereidax86/61559816602008"
                    target="_blank"
                    class="group relative aspect-square"
                    title="Facebook"
                >
                    <div
                        class="absolute -inset-0.5 bg-gradient-to-r from-blue-700 to-blue-600 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"
                    >
                    </div>
                    <div
                        class="relative h-full bg-neutral-900 rounded-xl border border-neutral-800 group-hover:border-blue-600/50 transition-all flex items-center justify-center group-hover:bg-neutral-800"

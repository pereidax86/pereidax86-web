                    class="group relative aspect-square"
                    title="Twitch"
                >
                    <div
                        class="absolute -inset-0.5 bg-gradient-to-r from-purple-700 to-purple-600 rounded-xl blur opacity-0 group-hover:opacity-75 transition duration-300"

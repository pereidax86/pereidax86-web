                    <span class="flex items-center gap-3">
                        <svg
                            class="w-6 h-6 text-green-500"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                            ></path>
                        </svg>
                        Sessionize
                    </span>
                </button>
            </a>
        </div>

        {/* --- BLOG CAROUSEL --- */}
        <div class="w-full pt-2 pb-8 flex flex-col items-center gap-6">
            <h3
                class="text-xs font-mono text-gray-500 uppercase tracking-widest text-center"
            >
                Últimas Entradas
            </h3>

            <div class="w-full relative group px-4 md:px-12">
                {/* Botón Izquierdo */}
                <button
                    id="carousel-prev"
                    class="absolute left-0 top-1/2 -translate-y-1/2 z-10 p-2 bg-neutral-900/80 border border-neutral-700 rounded-full text-white hover:bg-blue-600 hover:border-blue-500 transition-all hidden md:flex items-center justify-center shadow-lg backdrop-blur-sm"
                    aria-label="Anterior"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>

                {/* Scroll Container */}
                <div
                    id="carousel-container"
                    class="flex overflow-x-auto gap-4 py-4 px-2 snap-x snap-mandatory scrollbar-hide scroll-smooth"
                >
                    {
                        sortedPosts.map((post) => (
                            <a
                                href={`/blog/${post.slug}`}
                                class="snap-center shrink-0 w-80 md:w-96 first:pl-2 last:pr-2 block hover:scale-[1.02] transition-transform duration-300"
                            >
                                <article class="h-full bg-neutral-900/50 border border-neutral-800 rounded-xl overflow-hidden hover:border-blue-500/30 transition-colors flex flex-col">
                                    <div class="relative aspect-video overflow-hidden">
                                        <img
                                            src={post.data.image}
                                            alt={post.data.title}
                                            class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/90 to-transparent" />
                                    </div>
                                    <div class="p-4 flex flex-col flex-1 gap-2">
                                        <h4 class="text-white font-bold leading-tight line-clamp-2">
                                            {post.data.title}
                                        </h4>
                                        <p class="text-gray-400 text-sm line-clamp-2 flex-1">
                                            {post.data.description}
                                        </p>
                                        <div class="flex items-center justify-between mt-auto pt-2 text-xs font-mono text-blue-400">
                                            <span>
                                                {post.data.pubDate.toLocaleDateString()}
                                            </span>
                                            <span class="group-hover:translate-x-1 transition-transform">
                                                Leer más →
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        ))
                    }
                </div>

                {/* Botón Derecho */}
                <button
                    id="carousel-next"
                    class="absolute right-0 top-1/2 -translate-y-1/2 z-10 p-2 bg-neutral-900/80 border border-neutral-700 rounded-full text-white hover:bg-blue-600 hover:border-blue-500 transition-all hidden md:flex items-center justify-center shadow-lg backdrop-blur-sm"
                    aria-label="Siguiente"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>
        </div>

        {/* --- BLOG Y CONTACTO --- */}
        <div class="w-full pt-4 pb-8 space-y-4">
            <div class="flex gap-4 w-full">
                <a href="/blog" class="flex-1">
                    <button
                        class="w-full h-full bg-neutral-200 rounded-xl px-6 py-4 flex items-center justify-center gap-2 hover:scale-[1.01] transition-transform text-neutral-900 font-bold border-2 border-transparent hover:border-blue-500"
                    >
                        <span class="text-xl">🚀</span>
                        <span>Leer mi Blog</span>
                    </button>
                </a>

                <a href="/rss.xml" class="flex-none" title="Suscríbete al RSS">
                    <button
                        class="h-full aspect-square bg-orange-500/10 rounded-xl px-4 flex items-center justify-center gap-2 hover:scale-[1.01] transition-transform text-orange-500 font-bold border border-orange-500/50 hover:bg-orange-500 hover:text-white hover:border-transparent"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"
                            ></path>
                        </svg>
                    </button>
                </a>
            </div>

            {/* SECCIÓN CONTACTO*/}
            <div class="pt-4 text-center">
                <p class="text-sm text-gray-500 mb-3 font-mono">
                    ¿Quieres que trabajemos juntos?
                </p>
                <a href={`mailto:${EMAIL_CONTACTO}`} class="block w-full">
                    <button
                        class="group w-full bg-gradient-to-r from-neutral-900 to-neutral-800 rounded-xl px-6 py-4 flex items-center justify-center gap-3 hover:scale-[1.01] transition-all border border-neutral-700 hover:border-blue-500/50 shadow-lg"
                    >
                        <div
                            class="p-1.5 bg-blue-500/10 rounded-lg text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <span
                            class="text-gray-300 font-medium group-hover:text-white transition-colors"
                            >Pongámonos en contacto</span
                        >
                    </button>
                </a>
            </div>
        </div>

        {/* --- GITHUB SNAKE (NUEVO BLOQUE) --- */}
        <div class="w-full pt-2 pb-8 flex flex-col items-center gap-4">
            <h3
                class="text-xs font-mono text-gray-500 uppercase tracking-widest text-center"
            >
                Actividad en Código
            </h3>
            <div
                class="w-full flex justify-center bg-neutral-900/30 rounded-xl p-2 border border-neutral-800/50 hover:border-blue-500/20 transition-colors"
            >
                <img
                    src="https://raw.githubusercontent.com/pereidax86/pereidax86/output/github-contribution-grid-snake-dark.svg"
                    alt="GitHub Snake Animation"
                    class="w-full max-w-lg opacity-80 hover:opacity-100 transition-opacity duration-500"
                />
            </div>
        </div>

        <footer class="text-gray-600 text-xs font-mono text-center pb-8">
            <p>© 2025 Luis Pereida.</p>
            <p class="mt-1">Hecho con Astro 🚀 & Tailwind 🎨</p>
            <p class="mt-2 text-neutral-700">
                powered by
                <a
                    href="https://sysadminctl.services"
                    target="_blank"
                    class="text-blue-500/60 hover:text-blue-400 underline decoration-dotted transition-colors"
                >
                    sysadminctl.services🛡️
                </a>
            </p>
        </footer>
    </main>
    <script>
        const text = "@pereidax86";
        const typewriter = document.getElementById("typewriter");
        let i = 0;

        function type() {
            if (i < text.length) {
                if (typewriter) {
                    typewriter.innerHTML += text.charAt(i);
                }
                i++;
                setTimeout(type, 100);
            }
        }

        // Iniciar animación después de un breve delay
        setTimeout(type, 500);

        // --- CAROUSEL LOGIC ---
        const container = document.getElementById("carousel-container");
        const prevBtn = document.getElementById("carousel-prev");
        const nextBtn = document.getElementById("carousel-next");

        if (container && prevBtn && nextBtn) {
            const scrollAmount = 400; // Ancho aproximado de tarjeta + gap

            prevBtn.addEventListener("click", () => {
                container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
            });

            nextBtn.addEventListener("click", () => {
                container.scrollBy({ left: scrollAmount, behavior: "smooth" });
            });
        }
    </script>
</Layout>

---
// ==============================================================================
// 🎨 PALETA DE MARCA PERSONAL (DOCUMENTACIÓN)
// ==============================================================================
//
// PRIMARIOS (Tech & Cyberpunk):
// ------------------------------------------------------------------------------
// 🔵 Tech Blue (Principal/Acción):
//    - Tailwind: text-blue-500 | bg-blue-500 | border-blue-500
//    - Hex: #3b82f6
//    - Uso: Iconos principales, bordes activos, botones de llamada a la acción.
//
// 💠 Tech Blue Light (Texto/Brillo):
//    - Tailwind: text-blue-400
//    - Hex: #60a5fa
//    - Uso: Texto resaltado sobre fondo oscuro, efectos de glow.
//
// 🟣 Deep Purple (Acento/Profundidad):
//    - Tailwind: purple-600
//    - Hex: #9333ea
//    - Uso: Gradientes, sombras secundarias, detalles de fondo.
//
// NEUTROS (Fondo & Estructura):
// ------------------------------------------------------------------------------
// ⚫ Background Base: Neutral-950 (#0a0a0a) a Neutral-900 (#171717)
// ⚪ Texto Base: Gray-300 (#d1d5db) a White (#ffffff)
// ==============================================================================

import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// --- BLOG DATA ---
const allPosts = await getCollection("blog");
const sortedPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);

// --- CONFIGURACIÓN ---
const GRAVATAR_HASH = "4949755b64eb223f0fa2b210aaf9707c";
const GRAVATAR_URL = `https://www.gravatar.com/avatar/${GRAVATAR_HASH}?s=400`;
const EMAIL_CONTACTO = "luis@pereidax86.com";

// --- DATOS DEL PERFIL ---
const pageTitle = "Luis Pereida | @pereidax86";
const bioText =
    "Ingeniero en Sistemas y Maestro en TIC. Me apasiona el Open Source y desmitificar la tecnología. Comparto lo que sé sobre Linux, Ciberseguridad, Inteligencia Artificial y todo lo que ocurre detrás de una terminal de pantalla negra y letras blancas.";
const tiktokFollowers = "744";

const techStack = [
    { name: "Linux", icon: "🐧" },
    { name: "Red Hat", icon: "🎩" },
    { name: "Cybersecurity", icon: "🛡️" },
    { name: "Python", icon: "🐍" },
    { name: "AI & Automation", icon: "🤖" },
    { name: "Podman", icon: "🦭" },
    { name: "Open Source", icon: "🔓" },
    { name: "Astro", icon: "🚀" },
    { name: "Tailwind", icon: "🎨" },
];

const currentStatus = "🌱 Learning: CISSP & Advanced Red Teaming";
const philosophy =
    "Creo que cualquier concepto técnico complejo puede explicarse con una analogía simple. Mi meta es romper barreras y hacer el conocimiento accesible para todos.";

// --- CERTIFICACIONES ---
const certTop = {
    name: "Certified Ethical Hacker",
    image: "/badges/CEH_2E345519D3F7.png",
    url: "https://aspen.eccouncil.org/Verify",
    isCredly: false,
    meta: { id: "ECC3657809142", label: "ID Number" },
};

const certsMiddle = [
    {
        name: "RedHat Certified System Administrator",
        image: "/badges/rhcsa.png",
        url: "https://www.credly.com/badges/6701c173-e710-4c21-800a-ac6086ef59c1/public_url",
        isCredly: true,
    },
    {
        name: "RedHat Certified Specialist Virtualization",
        image: "/badges/rh-virtualization.png",
        url: "https://www.credly.com/badges/99a80d64-5d22-4944-bcf3-0e477eece1e6/public_url",
        isCredly: true,
    },
    {
        name: "RedHat Certified Specialist Containers",
        image: "/badges/rh-containers.png",
        url: "https://www.credly.com/badges/4f5dd55a-d796-44ad-af8d-d44f63ed4daa/public_url",
        isCredly: true,
    },
];

const certBottom = {
    name: "IBM Cloud Advocate v2",
    image: "/badges/ibm-cloud.png",
    url: "https://www.credly.com/badges/6cb65f66-7a49-473f-a9cd-7015c12c4e05/public_url",
    isCredly: true,
};
---

<Layout title={pageTitle} description={bioText}>
    <main
        class="w-full max-w-2xl px-6 py-12 flex flex-col items-center gap-8 animate-fade-in"
    >
        {/* --- HEADER --- */}
        <div class="text-center space-y-6 w-full">
            <div class="relative w-40 h-40 mx-auto group">
                <div
                    class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"
                >
                </div>
                <img
                    src={GRAVATAR_URL}
                    alt="Luis Pereida"
                    class="relative w-full h-full rounded-full object-cover bg-neutral-900 border-4 border-neutral-950 shadow-2xl"
                />
                <div
                    class="absolute bottom-2 right-2 bg-neutral-900 rounded-full p-1 border border-neutral-800"
                    title="SysAdmin Active"
                >
                    <div class="w-4 h-4 bg-blue-500 rounded-full animate-pulse">
                    </div>
                </div>
            </div>

            <div class="space-y-2 flex flex-col items-center">
                <p
                    class="text-lg md:text-2xl text-blue-400 font-mono font-bold text-center mt-2"
                >
                    Yo soy
                </p>
                <h1
                    class="text-5xl md:text-7xl font-extrabold text-white tracking-tight leading-tight"
                >
                    Luis Pereida
                </h1>
                <p
                    class="text-lg md:text-2xl text-blue-400 font-mono font-bold text-center mt-2 hover:text-white transition-colors duration-500 cursor-default"
                    style="text-shadow: 0 0 20px rgba(59, 130, 246, 0.3);"
                >
                    y hago ciberseguridad para todos
                </p>
                <p
                    class="text-base text-gray-400/80 font-mono mt-2 tracking-wide h-6 flex items-center gap-1"
                >
                    <span id="typewriter" class="text-gray-300"></span><span
                        class="animate-pulse bg-gray-300 w-2 h-4 block"></span>
                </p>

                {/* STATUS BAR (CISSP) */}
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900/80 border border-green-500/20 text-green-400/90 text-xs font-mono mt-2"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                        ></span>
                    </span>
                    {currentStatus}
                </div>
            </div>

            <div
                class="bg-neutral-900/50 backdrop-blur-sm border border-neutral-800 rounded-xl p-6 text-gray-300 leading-relaxed text-sm md:text-base max-w-xl mx-auto font-mono text-pretty"
            >
                <p>{bioText}</p>

                {/* TECH STACK PILLS */}
                <div
                    class="flex flex-wrap justify-center gap-2 mt-4 pt-4 border-t border-neutral-800/50"
                >
                    {
                        techStack.map((tech) => (
                            <span class="px-2.5 py-1 rounded-md bg-neutral-950 border border-neutral-800 text-xs text-blue-300 font-bold hover:border-blue-500/50 hover:text-blue-200 transition-colors cursor-default flex items-center gap-1.5">
                                <span>{tech.icon}</span>
                                {tech.name}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>

        <hr class="w-full border-neutral-800/50" />

        {/* --- FILOSOFÍA (Fun Fact) --- */}
        <div
            class="w-full bg-neutral-900/30 border-l-4 border-purple-600 rounded-r-xl p-6 italic text-gray-400 text-sm leading-relaxed"
        >
            <span
                class="block text-purple-400 font-bold text-xs not-italic mb-1 uppercase tracking-wider"

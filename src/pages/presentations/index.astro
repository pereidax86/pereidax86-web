---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const presentations = (await getCollection("presentations")).sort(
    (
        a: CollectionEntry<"presentations">,
        b: CollectionEntry<"presentations">,
    ) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = "Presentaciones | Luis Pereida";
const pageDesc =
    "Colección de presentaciones y charlas sobre tecnología, sysadmin y desarrollo.";
---

<Layout title={pageTitle} description={pageDesc}>
    <main class="w-full max-w-5xl px-6 py-12 mx-auto">
        <a
            href="/"
            class="inline-flex items-center gap-2 group mb-8 px-4 py-2.5 min-h-[44px] apple-glass-interactive text-gray-300 hover:text-white rounded-xl font-mono text-sm transition-all active:scale-95 shadow-sm"
        >
            <span class="group-hover:-translate-x-1 transition-transform" aria-hidden="true"
                >←</span
            >
            <span>Volver al Inicio</span>
        </a>

        <div class="text-center mb-16 space-y-4">
            <h1
                class="text-4xl md:text-6xl font-extrabold text-white tracking-[-0.035em] leading-[1.08] font-display"
            >
                Presentaciones
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600"
                >
                    Tech
                </span>
            </h1>
            <p class="text-xl text-gray-400 max-w-2xl mx-auto">
                {pageDesc}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                presentations.map((presentation) => (
                    <a
                        href={`/presentations/${presentation.slug}`}
                        class="group relative flex flex-col apple-glass-interactive rounded-2xl overflow-hidden"
                    >
                        <div class="aspect-video w-full overflow-hidden bg-neutral-950 relative flex items-center justify-center">
                            <span class="text-5xl group-hover:scale-110 transition-transform duration-500" aria-hidden="true">
                                📽️
                            </span>
                            <div class="absolute top-2 right-2 bg-black/70 backdrop-blur-md px-2 py-1 rounded text-xs font-mono text-gray-300 border border-white/10">
                                {presentation.data.pubDate.toLocaleDateString(
                                    "es-MX",
                                    {
                                        year: "numeric",
                                        month: "short",
                                        day: "numeric",
                                    },
                                )}
                            </div>
                        </div>

                        <div class="p-6 flex flex-col flex-1">
                            <div class="flex gap-2 mb-3">
                                {presentation.data.tags &&
                                    presentation.data.tags
                                        .slice(0, 2)
                                        .map((tag: string) => (
                                            <span class="text-[10px] uppercase font-bold tracking-wider text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-full border border-blue-500/20">
                                                {tag}
                                            </span>
                                        ))}
                            </div>

                            <h2 class="text-xl font-bold text-gray-100 mb-2 group-hover:text-blue-400 transition-colors leading-tight">
                                {presentation.data.title}
                            </h2>

                            <p class="text-gray-400 text-sm line-clamp-3 mb-4 flex-1">
                                {presentation.data.description}
                            </p>

                            <div class="flex items-center text-sm font-mono text-purple-400 group-hover:translate-x-1 transition-transform">
                                Ver presentación <span class="ml-2" aria-hidden="true">→</span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        {
            presentations.length === 0 && (
                <div class="text-center py-20 border border-dashed border-neutral-800 rounded-2xl">
                    <p class="text-gray-400 font-mono">
                        /var/log/messages: No presentations found yet.
                    </p>
                </div>
            )
        }
    </main>
</Layout>

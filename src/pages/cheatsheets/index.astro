---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CheatsheetCard from "../../components/CheatsheetCard.astro";

const allCheatsheets = await getCollection("cheatsheets");
const sortedCheatsheets = allCheatsheets.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = "Guías Rápidas de Supervivencia | @pereidax86";
const pageDescription =
    "Aprende lo esencial sin el miedo existencial. Guías prácticas, directas y con ejercicios para dominar Linux, Ansible, Docker y más.";
---

<Layout title={pageTitle} description={pageDescription}>
    <main class="w-full max-w-4xl px-6 py-12 mx-auto">
        <!-- Botón Volver -->
        <a
            href="/"
            class="inline-flex items-center gap-2 group mb-8 px-4 py-2.5 min-h-[44px] apple-glass-interactive text-gray-300 hover:text-white rounded-xl font-mono text-sm transition-all active:scale-95 shadow-sm"
        >
            <span class="group-hover:-translate-x-1 transition-transform" aria-hidden="true"
                >←</span
            >
            <span>Volver al Inicio</span>
        </a>

        <!-- Header -->
        <div class="text-center space-y-4 w-full mb-12">
            <h1
                class="text-4xl md:text-5xl font-extrabold text-white tracking-tight font-display"
            >
                ⚡ Guías Rápidas de Supervivencia
            </h1>
            <p class="text-lg text-gray-400 max-w-2xl mx-auto">
                Aprende lo esencial sin el miedo existencial. Todo con ejemplos
                prácticos, ejercicios y hasta chistes malos. Imprimible para
                llevar a donde sea.
            </p>
        </div>

        <!-- Grid de cheatsheets -->
        {
            sortedCheatsheets.length > 0 ? (
                <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {sortedCheatsheets.map((cheatsheet) => (
                        <CheatsheetCard
                            title={cheatsheet.data.title}
                            description={cheatsheet.data.description}
                            difficulty={cheatsheet.data.difficulty}
                            icon={cheatsheet.data.icon}
                            slug={cheatsheet.slug}
                            tags={cheatsheet.data.tags}
                            shortName={cheatsheet.data.shortName}
                        />
                    ))}
                </div>
            ) : (
                <div class="w-full text-center py-12">
                    <p class="text-gray-400 font-mono">Próximamente... 🚀</p>
                </div>
            )
        }
    </main>
</Layout>

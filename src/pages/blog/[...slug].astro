---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SocialShare from "../../components/SocialShare.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import SeriesBox from "../../components/SeriesBox.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString("es-MX", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readingTime = getReadingTime(post.body);

const breadcrumbItems = [
  { label: "Blog", href: "/blog" },
  { label: post.data.title, href: `/blog/${post.slug}` },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src}
  type="article"
  pubDate={post.data.pubDate}
>
  <main class="w-full max-w-5xl px-4 py-8 mx-auto animate-fade-in">
    {/* Migas de pan (Breadcrumbs) */}
    <Breadcrumbs items={breadcrumbItems} />

    <article class="w-full">
      <div class="text-center space-y-4 mb-10">
        <div
          class="flex flex-wrap items-center justify-center gap-2 text-xs font-mono text-purple-400 uppercase tracking-wider"
        >
          <span>{formattedDate}</span>
          <span>•</span>
          <span>{post.data.author}</span>
          <span>•</span>
          <span class="text-blue-400 font-semibold">⏱️ {readingTime}</span>
        </div>

        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-[-0.035em] leading-[1.08] font-display">
          {post.data.title}
        </h1>

        {
          post.data.description && (
            <p class="text-base md:text-lg text-gray-300 font-mono leading-relaxed max-w-3xl mx-auto pt-2 text-center">
              {post.data.description}
            </p>
          )
        }

        <div class="flex flex-wrap justify-center gap-2 mt-4">
          {
            post.data.tags.map((tag: string) => (
              <span class="px-2.5 py-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs text-gray-400 font-mono">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>

      {
        post.data.image && (
          <div class="w-full h-[300px] md:h-[450px] rounded-2xl overflow-hidden mb-12 border border-neutral-800 shadow-2xl">
            <Image
              src={post.data.image}
              alt={post.data.title}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        )
      }

      {/* --- NAVEGACIÓN DE SERIE (SUPERIOR) --- */}
      {
        post.data.series && (
          <div class="max-w-4xl mx-auto mb-8">
            <SeriesBox
              seriesId={post.data.series}
              seriesTitle={post.data.seriesTitle}
              currentSlug={post.slug}
            />
          </div>
        )
      }

      <div
        class="markdown-content max-w-4xl mx-auto text-gray-300 leading-relaxed text-lg"
      >
        <Content />
      </div>

      {/* --- NAVEGACIÓN DE SERIE (INFERIOR) --- */}
      {
        post.data.series && (
          <div class="max-w-4xl mx-auto mt-10">
            <SeriesBox
              seriesId={post.data.series}
              seriesTitle={post.data.seriesTitle}
              currentSlug={post.slug}
            />
          </div>
        )
      }
    </article>

    {/* --- BLOQUE DE COMPARTIR Y BARRA LATERAL FLOTANTE --- */}
    <SocialShare title={post.data.title} />

    {/* --- ARTÍCULOS RELACIONADOS --- */}
    <RelatedPosts
      currentSlug={post.slug}
      currentTags={post.data.tags || []}
      allPosts={allPosts}
    />
  </main>
</Layout>

<style is:global>
  .mermaid svg {
    overflow: visible !important;
  }
  .mermaid .node,
  .mermaid .node rect,
  .mermaid .node circle,
  .mermaid .node polygon,
  .mermaid .node path,
  .mermaid .label-container,
  .mermaid .basic.node,
  .mermaid .basic.node rect,
  .mermaid .block {
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.95)) !important;
    fill: #171717 !important;
    stroke: #ffffff !important;
    stroke-width: 1.5px !important;
  }
  .mermaid .edgePath .path,
  .mermaid .flowchart-link,
  .mermaid .edgePaths path,
  .mermaid path.path {
    stroke: #ffffff !important;
    stroke-width: 2px !important;
  }
  .mermaid .marker,
  .mermaid marker path,
  .mermaid #arrowhead path,
  .mermaid .arrowheadPath {
    fill: #ffffff !important;
    stroke: #ffffff !important;
  }
  .mermaid text,
  .mermaid .nodeLabel,
  .mermaid .edgeLabel,
  .mermaid p,
  .mermaid span,
  .mermaid div {
    fill: #ffffff !important;
    color: #ffffff !important;
    font-family: inherit !important;
  }
</style>

<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    theme: "base",
    themeVariables: {
      primaryColor: "#171717",
      primaryTextColor: "#ffffff",
      primaryBorderColor: "#ffffff",
      lineColor: "#ffffff",
      textColor: "#ffffff",
      edgeLabelBackground: "#171717",
      nodeBorder: "#ffffff",
      clusterBorders: "#ffffff",
      mainBkg: "#171717",
      fontFamily: "inherit",
    },
  });

  const renderMermaid = async () => {
    const mermaidBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"], code[data-language="mermaid"], pre.language-mermaid, code.language-mermaid, [data-language="mermaid"]'
    );
    if (mermaidBlocks.length === 0) return;

    mermaidBlocks.forEach((block, index) => {
      const targetElement = block.tagName === "PRE" ? block : block.closest("pre") || block;
      const content = block.textContent || "";
      const container = document.createElement("div");
      container.className =
        "mermaid flex justify-center my-8 overflow-x-auto p-6 bg-neutral-900/80 border border-neutral-800 rounded-2xl shadow-2xl shadow-black/60";
      container.id = `mermaid-${index}`;
      container.textContent = content.trim();
      targetElement.replaceWith(container);
    });

    await mermaid.run();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderMermaid);
  } else {
    renderMermaid();
  }
</script>

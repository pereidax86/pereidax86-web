---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SocialShare from "../../components/SocialShare.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString("es-MX", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readingTime = getReadingTime(post.body);

const breadcrumbItems = [
  { label: "Blog", href: "/blog" },
  { label: post.data.title, href: `/blog/${post.slug}` },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src}
  type="article"
  pubDate={post.data.pubDate}
>
  {/* Componente de compartición flotante lateral en Desktop */}
  <SocialShare title={post.data.title} />

  <main class="w-full max-w-5xl px-4 py-8 mx-auto animate-fade-in">
    {/* Migas de pan (Breadcrumbs) */}
    <Breadcrumbs items={breadcrumbItems} />

    <article class="w-full">
      <div class="text-center space-y-4 mb-10">
        <div
          class="flex flex-wrap items-center justify-center gap-2 text-xs font-mono text-purple-400 uppercase tracking-wider"
        >
          <span>{formattedDate}</span>
          <span>•</span>
          <span>{post.data.author}</span>
          <span>•</span>
          <span class="text-blue-400 font-semibold">⏱️ {readingTime}</span>
        </div>

        <h1 class="text-3xl md:text-5xl font-bold text-white leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap justify-center gap-2 mt-4">
          {
            post.data.tags.map((tag: string) => (
              <span class="px-2.5 py-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs text-gray-400 font-mono">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>

      {
        post.data.image && (
          <div class="w-full h-[300px] md:h-[450px] rounded-2xl overflow-hidden mb-12 border border-neutral-800 shadow-2xl">
            <Image
              src={post.data.image}
              alt={post.data.title}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        )
      }

      <div
        class="markdown-content max-w-4xl mx-auto text-gray-300 leading-relaxed text-lg"
      >
        <Content />
      </div>
    </article>

    {/* --- ARTÍCULOS RELACIONADOS --- */}
    <RelatedPosts
      currentSlug={post.slug}
      currentTags={post.data.tags || []}
      allPosts={allPosts}
    />
  </main>
</Layout>

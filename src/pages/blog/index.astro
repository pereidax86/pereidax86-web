---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog"))
	.filter((post: CollectionEntry<"blog">) => !post.data.draft)
	.sort(
		(a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

// Mapeo de nombres legibles e íconos para las Series
const seriesMap: Record<string, { label: string; icon: string }> = {
	"cissp-2024": { label: "Guía CISSP 2024", icon: "🛡️" },
	"owasp-top-10": { label: "OWASP Top 10", icon: "🔓" },
	"linux-esencial": { label: "Linux Esencial", icon: "🐧" },
	"linux-almacenamiento": { label: "Linux & Almacenamiento", icon: "💾" },
	"ansible": { label: "Ansible & Automatización", icon: "🤖" },
	"ciberseguridad-basica": { label: "Ciberseguridad Básica", icon: "🔒" },
	"fuera-del-registro": { label: "Fuera del Registro", icon: "🎙️" },
	"reflexiones": { label: "Reflexiones", icon: "💭" },
};

// Obtenemos la lista única de series presentes en las publicaciones
const uniqueSeriesKeys = Array.from(
	new Set(posts.map((post: CollectionEntry<"blog">) => post.data.series).filter(Boolean)),
) as string[];

// Obtenemos la lista única de etiquetas (tags) para el autocompletado del buscador
const allTags = Array.from(
	new Set(posts.flatMap((post: CollectionEntry<"blog">) => post.data.tags || [])),
).sort();

const pageTitle = "Blog | Luis Pereida";
const pageDesc =
	"Tutoriales, guías y opiniones sobre Linux, Ciberseguridad, Inteligencia Artificial y Open Source.";
---

<Layout title={pageTitle} description={pageDesc}>
	<main class="w-full max-w-5xl px-6 py-12 mx-auto animate-fade-in">
		<a href="/" class="inline-flex items-center gap-2 group">
			<button
				class="flex items-center gap-2 px-4 py-2 apple-glass-interactive text-gray-300 hover:text-white rounded-xl font-mono text-sm transition-all active:scale-95 shadow-sm cursor-pointer"
			>
				<span class="group-hover:-translate-x-1 transition-transform">←</span>
				Volver al Inicio
			</button>
		</a>

		<div class="text-center mb-10 space-y-4">
			<h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-[-0.035em] leading-[1.08] font-display">
				Bitácora del <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600">sysadmin</span>
			</h1>
			<p class="text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
				{pageDesc}
			</p>

			<a
				href="/rss.xml"
				class="inline-flex items-center gap-2 px-4 py-2 mt-4 text-orange-500 apple-glass-interactive border-orange-500/50 rounded-xl hover:bg-orange-500 hover:text-white hover:border-transparent transition-all active:scale-95 font-bold"
				title="Suscríbete a nuestro Feed RSS"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-5 h-5"
					fill="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"
					></path>
				</svg>
				Suscribirse al RSS
			</a>
		</div>

		{/* NAVEGACIÓN Y FILTROS POR SERIES */}
		<div class="mb-10 space-y-6 max-w-4xl mx-auto">
			{/* Botones de Series (Categorías principales) */}
			<div class="flex flex-wrap items-center justify-center gap-2" id="series-filters">
				<button
					data-series="all"
					class="series-btn active-series px-3.5 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-blue-600 text-white border border-blue-500 shadow-md shadow-blue-500/20 active:scale-95 cursor-pointer flex items-center gap-1.5"
				>
					✨ Todas ({posts.length})
				</button>
				{uniqueSeriesKeys.map((seriesKey) => {
					const samplePost = posts.find((p: any) => p.data.series === seriesKey);
					const fallbackLabel = samplePost?.data.seriesTitle || seriesKey;
					const info = seriesMap[seriesKey] || { label: fallbackLabel, icon: "📁" };
					const count = posts.filter((p: any) => p.data.series === seriesKey).length;
					return (
						<button
							data-series={seriesKey}
							class="series-btn px-3.5 py-2 rounded-xl text-xs font-mono font-medium transition-all apple-glass-interactive text-gray-300 hover:text-white active:scale-95 cursor-pointer flex items-center gap-1.5 shadow-sm"
						>
							<span>{info.icon}</span>
							{info.label} ({count})
						</button>
					);
				})}
			</div>

			{/* Barra de búsqueda con Autocompletado de Tags */}
			<div class="relative max-w-2xl mx-auto">
				<div class="relative">
					<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
						</svg>
					</div>
					<input
						type="text"
						id="blog-search"
						placeholder="Buscar por título, contenido o etiqueta (ej: #ansible)..."
						class="w-full pl-11 pr-10 py-3.5 apple-glass rounded-xl text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500/70 focus:ring-2 focus:ring-blue-500/20 transition-all font-mono text-sm shadow-inner"
						autocomplete="off"
					/>
					<button
						id="clear-search"
						class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-gray-500 hover:text-white transition-colors cursor-pointer"
						title="Limpiar búsqueda"
						type="button"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>

				{/* Panel de Sugerencias de Tags */}
				<div id="tag-suggestions" class="hidden flex flex-wrap items-center gap-1.5 pt-2 px-1 text-xs font-mono text-gray-400">
					<span class="text-gray-500 font-semibold mr-1">Etiquetas sugeridas:</span>
					<div id="suggestions-list" class="flex flex-wrap items-center gap-1.5 inline-flex"></div>
				</div>
			</div>

			{/* Contador de publicaciones encontradas */}
			<div class="text-center font-mono text-xs text-gray-500" id="search-counter">
				Mostrando <span id="visible-count" class="text-blue-400 font-bold">{posts.length}</span> de {posts.length} artículos
			</div>
		</div>

		{/* Grid de Artículos */}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
			{
				posts.map((post: any) => (
					<a
						href={`/blog/${post.slug}`}
						class="post-card group relative flex flex-col apple-glass-interactive rounded-2xl overflow-hidden hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10 active:scale-[0.98] transition-all duration-300"
						data-title={post.data.title.toLowerCase()}
						data-description={post.data.description.toLowerCase()}
						data-series={post.data.series || ""}
						data-tags={(post.data.tags || []).map((t: string) => t.toLowerCase()).join(",")}
					>
						<div class="aspect-video w-full overflow-hidden bg-neutral-950 relative">
							{post.data.image ? (
								<Image
									src={post.data.image}
									alt={post.data.title}
									class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
								/>
							) : (
								<div class="w-full h-full flex items-center justify-center bg-neutral-900">
									<span class="text-4xl">🐧</span>
								</div>
							)}

							<div class="absolute top-2 right-2 bg-black/70 backdrop-blur-md px-2 py-1 rounded text-xs font-mono text-gray-300 border border-white/10">
								{post.data.pubDate.toLocaleDateString("es-MX", {
									year: "numeric",
									month: "short",
									day: "numeric",
								})}
							</div>
						</div>

						<div class="p-6 flex flex-col flex-1">
							<div class="flex flex-wrap gap-2 mb-3">
								{post.data.tags
									.slice(0, 2)
									.map((tag: string) => (
										<span class="text-[10px] uppercase font-bold tracking-wider text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-full border border-blue-500/20">
											{tag}
										</span>
									))}
							</div>

							<h3 class="text-xl font-bold text-gray-100 mb-2 group-hover:text-blue-400 transition-colors leading-tight">
								{post.data.title}
							</h3>

							<p class="text-gray-400 text-sm leading-relaxed mb-4 flex-1">
								{post.data.description}
							</p>

							<div class="flex items-center text-sm font-mono text-purple-400 group-hover:translate-x-1 transition-transform">
								Leer artículo <span class="ml-2">→</span>
							</div>
						</div>
					</a>
				))
			}
		</div>

		{/* Estado cuando no hay resultados de búsqueda */}
		<div id="no-results" class="hidden text-center py-16 border border-dashed border-neutral-800 rounded-2xl space-y-4">
			<p class="text-gray-300 font-mono text-lg">
				🔍 /var/log/messages: 0 resultados encontrados
			</p>
			<p class="text-gray-500 text-sm max-w-md mx-auto">
				No se encontraron publicaciones que coincidan con la búsqueda. Intenta con otras palabras clave o restablece los filtros.
			</p>
			<button
				id="reset-search-btn"
				class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-blue-400 hover:text-blue-300 rounded-lg font-mono text-xs transition-all border border-neutral-700 inline-flex items-center gap-2 cursor-pointer"
			>
				🔄 Restablecer filtros
			</button>
		</div>
	</main>
</Layout>

<script is:inline define:vars={{ allTags }}>
	function initBlogSearch() {
		const searchInput = document.getElementById("blog-search");
		const clearBtn = document.getElementById("clear-search");
		const postCards = document.querySelectorAll(".post-card");
		const seriesBtns = document.querySelectorAll(".series-btn");
		const visibleCountEl = document.getElementById("visible-count");
		const noResultsEl = document.getElementById("no-results");
		const resetBtn = document.getElementById("reset-search-btn");
		const suggestionsBox = document.getElementById("tag-suggestions");
		const suggestionsList = document.getElementById("suggestions-list");

		let activeSeries = "all";
		let searchQuery = "";

		function filterPosts() {
			let visibleCount = 0;

			postCards.forEach((card) => {
				const title = card.dataset.title || "";
				const description = card.dataset.description || "";
				const series = card.dataset.series || "";
				const tags = (card.dataset.tags || "").split(",");

				const cleanQuery = searchQuery.startsWith("#") ? searchQuery.slice(1) : searchQuery;

				const matchesQuery =
					!cleanQuery ||
					title.includes(cleanQuery) ||
					description.includes(cleanQuery) ||
					tags.some((t) => t.includes(cleanQuery));

				const matchesSeries =
					activeSeries === "all" || series === activeSeries;

				if (matchesQuery && matchesSeries) {
					card.style.display = "";
					visibleCount++;
				} else {
					card.style.display = "none";
				}
			});

			if (visibleCountEl) {
				visibleCountEl.textContent = visibleCount.toString();
			}

			if (noResultsEl) {
				if (visibleCount === 0 && postCards.length > 0) {
					noResultsEl.classList.remove("hidden");
				} else {
					noResultsEl.classList.add("hidden");
				}
			}

			if (clearBtn) {
				if (searchQuery.length > 0) {
					clearBtn.classList.remove("hidden");
				} else {
					clearBtn.classList.add("hidden");
				}
			}

			updateTagSuggestions();
		}

		function updateTagSuggestions() {
			if (!suggestionsBox || !suggestionsList) return;

			const query = searchQuery.trim().toLowerCase().replace(/^#/, "");

			if (query.length >= 2) {
				const matchingTags = allTags.filter((t) =>
					t.toLowerCase().includes(query)
				);

				if (matchingTags.length > 0) {
					suggestionsList.innerHTML = matchingTags
						.slice(0, 5)
						.map(
							(tag) =>
								`<button data-suggested-tag="${tag.toLowerCase()}" class="suggested-tag-btn px-2.5 py-0.5 rounded-full text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20 hover:bg-blue-500/20 transition-colors cursor-pointer">#${tag}</button>`
						)
						.join("");

					suggestionsBox.classList.remove("hidden");

					document.querySelectorAll(".suggested-tag-btn").forEach((btn) => {
						btn.addEventListener("click", () => {
							const selectedTag = btn.dataset.suggestedTag || "";
							if (searchInput) {
								searchInput.value = "#" + selectedTag;
								searchQuery = "#" + selectedTag;
								filterPosts();
							}
						});
					});
					return;
				}
			}

			suggestionsBox.classList.add("hidden");
		}

		if (searchInput) {
			searchInput.addEventListener("input", (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				filterPosts();
			});

			searchInput.addEventListener("keydown", (e) => {
				if (e.key === "Escape") {
					searchInput.value = "";
					searchQuery = "";
					filterPosts();
				}
			});
		}

		if (clearBtn) {
			clearBtn.addEventListener("click", () => {
				if (searchInput) {
					searchInput.value = "";
					searchQuery = "";
					searchInput.focus();
					filterPosts();
				}
			});
		}

		seriesBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				seriesBtns.forEach((b) => {
					b.classList.remove(
						"bg-blue-600",
						"text-white",
						"border-blue-500",
						"shadow-md",
						"shadow-blue-500/20",
						"font-bold",
						"active-series"
					);
					b.classList.add(
						"bg-neutral-900/80",
						"text-gray-300",
						"border-neutral-800",
						"font-medium"
					);
				});

				btn.classList.remove(
					"bg-neutral-900/80",
					"text-gray-300",
					"border-neutral-800",
					"font-medium"
				);
				btn.classList.add(
					"bg-blue-600",
					"text-white",
					"border-blue-500",
					"shadow-md",
					"shadow-blue-500/20",
					"font-bold",
					"active-series"
				);

				activeSeries = btn.dataset.series || "all";
				filterPosts();
			});
		});

		if (resetBtn) {
			resetBtn.addEventListener("click", () => {
				if (searchInput) searchInput.value = "";
				searchQuery = "";
				activeSeries = "all";

				const allBtn = document.querySelector('.series-btn[data-series="all"]');
				if (allBtn) {
					allBtn.click();
				} else {
					filterPosts();
				}
			});
		}
	}

	initBlogSearch();
	document.addEventListener("astro:page-load", initBlogSearch);
</script>

